          <span>${escapeHtml(mhs.kelas || '-')} &bull; ${escapeHtml(mhs.jurusan || '-')}</span>
        </div>
        <div style="display:flex; justify-content:space-between;">
          <span style="color:var(--text-muted); font-size:12px;">Waktu Presensi</span>
          <span style="color:var(--accent-light); font-weight:800;">${escapeHtml(waktuStr)}</span>
        </div>
      `;
      modal.classList.add('show');
    }

    function closeSuccessModal() {
      const modal = $('successModalLayer');
      if (modal) modal.classList.remove('show');
    }

    // ==========================================================================
    // KTM 3D FLIP STUDIO ENGINE
    // ==========================================================================
    function populateKtmDatalist() {
      const datalist = $('ktmDatalist');
      if (!datalist) return;
      datalist.innerHTML = '';
      State.mahasiswa.forEach(m => {
        const opt = document.createElement('option');
        opt.value = m.nim;
        opt.label = `${m.nama} (${m.kelas || '-'})`;
        datalist.appendChild(opt);
      });
    }

    function autoSelectStudentForKTM() {
      const nim = ($('ktmNimInput')?.value || '').trim();
      const mhs = State.mahasiswa.find(m => String(m.nim).trim() === nim);
      if (mhs) renderKTMCard();
    }

    function openKtmForStudent(nim) {
      switchView('ktm');
      if ($('ktmNimInput')) $('ktmNimInput').value = nim;
      renderKTMCard();
    }

    function renderKTMCard() {
      const input = $('ktmNimInput');
      const nim = (input ? input.value : '').trim();

      if (!nim) {
        showToast('Pilih atau ketik NIM mahasiswa', 'warning', 2500);
        if (input) input.focus();
        return;
      }

      const mhs = State.mahasiswa.find(m => String(m.nim).trim() === nim);
      if (!mhs) {
        showToast(`NIM ${nim} tidak ditemukan dalam daftar!`, 'error', 3000);
        return;
      }

      $('ktmCardName').textContent = mhs.nama || '-';
      $('ktmCardNim').textContent = mhs.nim;
      $('ktmCardJurusan').textContent = mhs.jurusan || 'Teknik Informatika';
      $('ktmCardKelas').textContent = `Kelas: ${mhs.kelas || '-'}`;
      $('ktmAvatarInitials').textContent = (mhs.nama || 'M').charAt(0).toUpperCase();
      if ($('ktmBarcodeNum')) $('ktmBarcodeNum').textContent = `${mhs.nim}0000`;

      const qrPayload = {
        nim: mhs.nim,
        nama: mhs.nama,
        kelas: mhs.kelas,
        jurusan: mhs.jurusan,
        link_sheet: CONFIG.SHEET_URL,
        timestamp: new Date().toISOString()
      };

      const qrUrl = `https://api.qrserver.com/v1/create-qr-code/?size=300x300&data=${encodeURIComponent(JSON.stringify(qrPayload))}`;
      $('ktmCardQrImg').src = qrUrl;

      showToast(`KTM 3D siap untuk ${mhs.nama}`, 'success', 2200);
    }

    function downloadKtmCard() {
      const nim = ($('ktmNimInput')?.value || 'student').trim();
      const canvas = document.createElement('canvas');
      canvas.width = 800;
      canvas.height = 480;
      const ctx = canvas.getContext('2d');

      const grad = ctx.createLinearGradient(0, 0, 800, 480);
      grad.addColorStop(0, '#0b1120');
      grad.addColorStop(0.5, '#1e1b4b');
      grad.addColorStop(1, '#064e3b');
      ctx.fillStyle = grad;
      ctx.beginPath();
      ctx.roundRect(0, 0, 800, 480, 36);
      ctx.fill();

      ctx.strokeStyle = '#6366f1';
      ctx.lineWidth = 3;
      ctx.stroke();

      ctx.fillStyle = '#ffffff';
      ctx.font = 'bold 24px "Plus Jakarta Sans", sans-serif';
      ctx.fillText('UNIVERSITAS TEKNOLOGI', 90, 68);
      ctx.fillStyle = '#818cf8';
      ctx.font = '14px "JetBrains Mono", monospace';
      ctx.fillText('KARTU TANDA MAHASISWA 3D DIGITAL', 90, 96);

      ctx.fillStyle = '#4f46e5';
      ctx.beginPath();
      ctx.roundRect(50, 150, 130, 130, 24);
      ctx.fill();
      ctx.fillStyle = '#ffffff';
      ctx.font = 'bold 64px "Plus Jakarta Sans", sans-serif';
      ctx.textAlign = 'center';
      const initial = ($('ktmCardName').textContent || 'M').charAt(0).toUpperCase();
      ctx.fillText(initial, 115, 238);
      ctx.textAlign = 'left';

      ctx.fillStyle = '#ffffff';
      ctx.font = 'bold 28px "Plus Jakarta Sans", sans-serif';
      ctx.fillText($('ktmCardName').textContent, 210, 185);

      ctx.fillStyle = '#34d399';
      ctx.font = 'bold 22px "JetBrains Mono", monospace';
      ctx.fillText('NIM: ' + $('ktmCardNim').textContent, 210, 225);

      ctx.fillStyle = 'rgba(255,255,255,0.85)';
      ctx.font = '18px "Plus Jakarta Sans", sans-serif';
      ctx.fillText($('ktmCardJurusan').textContent, 210, 260);
      ctx.fillStyle = '#a855f7';
      ctx.fillText($('ktmCardKelas').textContent, 210, 290);

      const qrImg = $('ktmCardQrImg');
      const img = new Image();
      img.crossOrigin = 'anonymous';
      img.onload = () => {
        ctx.fillStyle = '#ffffff';
        ctx.beginPath();
        ctx.roundRect(570, 130, 180, 180, 20);
        ctx.fill();
        ctx.drawImage(img, 580, 140, 160, 160);

        ctx.fillStyle = 'rgba(255,255,255,0.5)';
        ctx.font = '14px "JetBrains Mono", monospace';
        ctx.fillText('SMART PRESENSI 3D CERTIFIED • TAHUN AKADEMIK 2026/2027', 50, 420);

        const a = document.createElement('a');
        a.download = `KTM-Digital-${nim}.png`;
        a.href = canvas.toDataURL('image/png');
        a.click();
        showToast('KTM Digital berhasil diunduh (PNG)', 'success', 2500);
      };
      img.src = qrImg.src;
    }

    function printKtmCard() { window.print(); }

    // ==========================================================================
    // QR KELAS & AUDITORIUM PROJECTOR
    // ==========================================================================
    function generateClassQR() {
      const classPayload = {
        nim: 'ABSENSI-KELAS',
        nama: 'Presensi Kelas Masal',
        kelas: 'Semua',
        jurusan: 'Semua',
        link_sheet: CONFIG.SHEET_URL,
        timestamp: new Date().toISOString()
      };

      const qrUrl = `https://api.qrserver.com/v1/create-qr-code/?size=450x450&data=${encodeURIComponent(JSON.stringify(classPayload))}`;
      if ($('classMainQrImg')) $('classMainQrImg').src = qrUrl;
      if ($('projectorOverlayQrImg')) $('projectorOverlayQrImg').src = qrUrl;
    }

    function downloadClassQR() {
      const img = $('classMainQrImg');
      if (!img || !img.src) return;

      const a = document.createElement('a');
      a.download = `QR-Presensi-Kelas-Utama.png`;
      a.href = img.src;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      showToast('QR Kelas berhasil diunduh', 'success', 2000);
    }

    function openFullscreenProjector() {
      const overlay = $('projectorOverlay');
      if (!overlay) return;
      overlay.style.display = 'flex';

      if (document.documentElement.requestFullscreen) {
        document.documentElement.requestFullscreen().catch(() => {});
      }
    }

    function closeFullscreenProjector() {
      const overlay = $('projectorOverlay');
      if (overlay) overlay.style.display = 'none';

      if (document.fullscreenElement && document.exitFullscreen) {
        document.exitFullscreen().catch(() => {});
      }
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeFullscreenProjector();
    });

    // ==========================================================================
    // CSV EXPORT
    // ==========================================================================
    function exportAttendanceCSV() {
      if (!State.mahasiswa.length) {
        showToast('Tidak ada data untuk diekspor', 'warning', 2500);
        return;
      }

      let csv = 'No,NIM,Nama Mahasiswa,Jurusan,Kelas,Status,Waktu Presensi\n';
      State.mahasiswa.forEach((m, idx) => {
        const nim = String(m.nim || '').trim();
        const hadir = State.presensiHariIni[nim];
        const status = hadir ? 'Hadir' : 'Belum Hadir';
        const waktu = hadir ? (hadir.waktu || 'Hadir') : '-';
        csv += `"${idx + 1}","${m.nim}","${m.nama || ''}","${m.jurusan || ''}","${m.kelas || ''}","${status}","${waktu}"\n`;
      });

      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.download = `Rekap-Presensi-3D-${todayStr()}.csv`;
      a.href = url;
      a.click();
      URL.revokeObjectURL(url);
      showToast('File CSV berhasil diunduh', 'success', 2500);
    }

    // ==========================================================================
    // INITIALIZATION
    // ==========================================================================
    async function initApp() {
      initTheme();
      initThreeJS();

      const sheetUrlPresensi = CONFIG.SHEET_URL.split('#')[0] + '#gid=' + CONFIG.SHEET_GID_PRESENSI;
      if ($('sheetLink')) $('sheetLink').href = sheetUrlPresensi;

      generateClassQR();
      await loadAllData();

      setTimeout(startScanner, 600);
      setInterval(loadAllData, CONFIG.REFRESH_INTERVAL_MS);
    }

    document.addEventListener('DOMContentLoaded', initApp);

    window.addEventListener('beforeunload', () => {
      if (State.scanner && State.scanning) {
        State.scanner.stop().catch(() => {});
      }
    });
  </script>
</body>
</html>
