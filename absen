      const tbody = $('attendanceTableBody');
      if (!tbody) return;
      tbody.innerHTML = '';

      if (!State.mahasiswa.length) {
        showTableEmpty('empty');
        return;
      }

      let filtered = State.mahasiswa.filter(m => {
