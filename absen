    // ==========================================================================
    // 3D SCANNER ENGINE
    // ==========================================================================
    function toggleScanner() {
      if (State.scanning) stopScanner();
      else startScanner();
    }

    function switchCameraMode() {
      State.facingMode = State.facingMode === 'environment' ? 'user' : 'environment';
      showToast(`Kamera ${State.facingMode === 'environment' ? 'belakang' : 'depan'}`, 'info', 1800);
      if (State.scanning) {
        stopScanner().then(() => setTimeout(startScanner, 350));
      }
    }

    async function startScanner() {
      if (State.scanning) return;
      if (State.scanner) {
        try { await State.scanner.clear(); } catch {}
        State.scanner = null;
      }

      const readerEl = $('qr-reader');
      if (readerEl) readerEl.innerHTML = '';

      updateScanButtonState(true);

      try {
        State.scanner = new Html5Qrcode("qr-reader", {
          verbose: false,
          formatsToSupport: [Html5QrcodeSupportedFormats.QR_CODE]
        });

        const config = { fps: 15, qrbox: { width: 180, height: 180 }, aspectRatio: 1.0 };
        const onSuccess = (text) => onScanSuccess(text);
        const onError = () => {};

        await State.scanner.start({ facingMode: State.facingMode }, config, onSuccess, onError);
        State.scanning = true;
        if ($('scannerStatusText')) $('scannerStatusText').textContent = 'Sensor Aktif &bull; Pindai QR';
        if ($('laserBeam')) $('laserBeam').style.display = 'block';
      } catch (err) {
        try {
          const altMode = State.facingMode === 'environment' ? 'user' : 'environment';
          await State.scanner.start({ facingMode: altMode }, { fps: 12, qrbox: 180 }, (t) => onScanSuccess(t), () => {});
          State.facingMode = altMode;
          State.scanning = true;
          if ($('scannerStatusText')) $('scannerStatusText').textContent = 'Kamera Depan Aktif';
        } catch (err2) {
          showToast('Kamera tidak dapat diakses: ' + err2.message, 'error', 5000);
          playBeep('error');
          updateScanButtonState(false);
        }
      }
    }

    async function stopScanner() {
      if (State.scanner && State.scanning) {
        try {
          await State.scanner.stop();
          await State.scanner.clear();
        } catch (e) {}
        State.scanner = null;
      }
      State.scanning = false;
      updateScanButtonState(false);
      if ($('scannerStatusText')) $('scannerStatusText').textContent = 'Scanner berhenti';
      if ($('laserBeam')) $('laserBeam').style.display = 'none';
    }

    function updateScanButtonState(isScanning) {
      const btn = $('btnToggleScan');
      const icon = $('btnScanIcon');
      const text = $('btnScanText');
      if (!btn) return;

      if (isScanning) {
        btn.classList.add('btn-stop-danger');
        btn.classList.remove('btn-primary-gradient');
        icon.className = 'fas fa-stop';
        text.textContent = 'Stop Scan';
      } else {
        btn.classList.remove('btn-stop-danger');
        btn.classList.add('btn-primary-gradient');
        icon.className = 'fas fa-play';
        text.textContent = 'Mulai Scan';
      }
    }

    async function toggleFlash() {
      State.flashOn = !State.flashOn;
      try {
        const video = document.querySelector('#qr-reader video');
        if (!video || !video.srcObject) return;
        const track = video.srcObject.getVideoTracks()[0];
        if (!track) return;
        const caps = track.getCapabilities ? track.getCapabilities() : {};
        if (caps.torch) {
          await track.applyConstraints({ advanced: [{ torch: State.flashOn }] });
        } else {
          showToast('Flashlight tidak didukung pada kamera ini', 'warning', 2500);
        }
      } catch (e) {}
    }

    function triggerFileInput() {
      const fileInput = $('qrFileInput');
      if (fileInput) fileInput.click();
    }

    function handleQrFile(input) {
      if (!input.files || input.files.length === 0) return;
      const file = input.files[0];
      const html5QrCode = new Html5Qrcode("qr-reader");

      showToast('Memindai gambar QR...', 'info', 0);
      html5QrCode.scanFile(file, true)
        .then(decodedText => {
          onScanSuccess(decodedText);
          input.value = '';
        })
        .catch(err => {
          playBeep('error');
          showToast('Gagal membaca QR Code dari file: ' + err, 'error', 3500);
          input.value = '';
        });
    }

    function onScanSuccess(decodedText) {
      if (State.processing) return;
      State.processing = true;

      if (navigator.vibrate) navigator.vibrate([70, 40, 70]);
      processPresensi(decodedText);
    }

    function punchManualNIM() {
      const input = $('manualNimInput');
      const nim = (input ? input.value : '').trim();
      if (!nim) {
        showToast('Ketik NIM terlebih dahulu!', 'warning', 2500);
        if (input) input.focus();
        return;
      }
      processPresensi(nim);
      if (input) input.value = '';
    }

    function checkInManual(nim) {
      processPresensi(nim);
    }

    async function processPresensi(qrRaw) {
      const tanggal = todayStr();
      try {
        showToast('Memverifikasi presensi...', 'info', 0);

        let nim = '';
        try {
          const parsed = JSON.parse(qrRaw);
          nim = String(parsed.nim || '').trim();
        } catch {
          nim = String(qrRaw || '').trim();
        }

        if (!nim || nim.length < 3) {
          playBeep('error');
          showToast('Format QR Code tidak valid!', 'error', 3000);
          return;
        }

        const mhs = State.mahasiswa.find(m => String(m.nim).trim() === nim);
        if (!mhs) {
          playBeep('error');
          showToast(`NIM ${nim} tidak terdaftar di kelas!`, 'error', 3500);
          return;
        }

        if (State.presensiHariIni[nim]) {
          playBeep('warning');
          showToast(`⚠️ ${mhs.nama} sudah tercatat hadir hari ini!`, 'warning', 3500);
          return;
        }

        const payload = {
          nim,
          nama: mhs.nama || '',
          kelas: mhs.kelas || '',
          jurusan: mhs.jurusan || '',
          mataKuliah: 'Presensi Kelas',
          status: 'Hadir'
        };

        let result;
        try {
          result = await apiPost('presensi', payload);
        } catch (netErr) {
          const jamNow = new Date().toLocaleTimeString('id-ID');
          const rec = { nim, tanggal, offline: true, waktu: `${tanggal} ${jamNow}` };
          State.presensiHariIni[nim] = rec;
          saveCachePresensi(State.presensiHariIni);

          const q = loadOfflineQueue();
          q.push(payload);
          saveOfflineQueue(q);

          updateStats();
          renderTable();
          playBeep('success');
          triggerSuccessConfetti();
          openSuccessModal(mhs, `${jamNow} (Tersimpan Lokal/Offline)`);
          return;
        }

        if (result.success) {
          const jamRes = result.waktu || new Date().toLocaleTimeString('id-ID');
          State.presensiHariIni[nim] = {
            nim,
            tanggal,
            waktu: jamRes,
            nama: mhs.nama
          };
          saveCachePresensi(State.presensiHariIni);
          updateStats();
          renderTable();
          playBeep('success');
          triggerSuccessConfetti();
          openSuccessModal(mhs, jamRes);
        } else if (result.already) {
          playBeep('warning');
          State.presensiHariIni[nim] = { nim, tanggal, waktu: result.data?.waktu || '' };
          saveCachePresensi(State.presensiHariIni);
          updateStats();
          renderTable();
          showToast(`⚠️ ${mhs.nama} sudah tercatat sebelumnya`, 'warning', 3500);
        } else {
          playBeep('error');
          showToast('❌ Gagal: ' + (result.error || 'Terjadi kesalahan sistem'), 'error', 4000);
        }

      } catch (err) {
        console.error(err);
        playBeep('error');
        showToast('Terjadi kesalahan: ' + err.message, 'error', 4000);
      } finally {
        setTimeout(() => {
          State.processing = false;
        }, CONFIG.RESCAN_DELAY_MS);
      }
    }

    function triggerSuccessConfetti() {
      try {
        if (typeof confetti === 'function') {
          confetti({
            particleCount: 80,
            spread: 75,
            origin: { y: 0.65 },
            colors: ['#6366f1', '#10b981', '#06b6d4', '#f59e0b']
          });
        }
      } catch (e) {}
    }

