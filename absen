  <script>
    const CONFIG = {
      API_URL: 'https://script.google.com/macros/s/AKfycbwFaiXWeQmp9D1U6YKlNM2u28Dgp8mcnYmzWxoWXH_FS3Po3oWJt1-kknsCZ_yRDranPQ/exec',
      SHEET_URL: 'https://docs.google.com/spreadsheets/d/1PXOSZAXZNg7hvX-33DglZlM3saj4yclUhiYepiFNYhI/edit?gid=0#gid=0',
      SHEET_GID_MAHASISWA: '0',
      SHEET_GID_PRESENSI: '646034675',
      CACHE_KEY_MAHASISWA: 'presensi_mahasiswa_cache_v2',
      CACHE_KEY_PRESENSI: 'presensi_hari_ini_cache_v2',
      CACHE_KEY_OFFLINE_QUEUE: 'presensi_offline_queue_v2',
      REFRESH_INTERVAL_MS: 30000,
      RESCAN_DELAY_MS: 2200
    };

    const State = {
      scanner: null,
      scanning: false,
      flashOn: false,
      processing: false,
      facingMode: "environment",
      mahasiswa: [],
      presensiHariIni: {},
      isOnline: false,
      audioEnabled: true,
      currentFilter: 'all',
      searchQuery: '',
      tanggalHariIni: '',
      activeView: 'cockpit',
      isCardFlipped: false
    };

    const $ = id => document.getElementById(id);

    // ==========================================================================
    // THREE.JS SPATIAL WEBGL 3D BACKGROUND
    // ==========================================================================
    let threeScene, threeCamera, threeRenderer, particleMesh;

    function initThreeJS() {
      const canvas = $('webgl-canvas');
      if (!canvas || typeof THREE === 'undefined') return;

      threeScene = new THREE.Scene();
      threeCamera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
      threeCamera.position.z = 85;

      threeRenderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
      threeRenderer.setSize(window.innerWidth, window.innerHeight);
      threeRenderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

      // 3D Spatial Particle Constellation
      const count = 300;
      const geo = new THREE.BufferGeometry();
      const pos = new Float32Array(count * 3);
      const col = new Float32Array(count * 3);

      const color1 = new THREE.Color(0x6366f1);
      const color2 = new THREE.Color(0x10b981);

      for (let i = 0; i < count; i++) {
        pos[i * 3] = (Math.random() - 0.5) * 180;
        pos[i * 3 + 1] = (Math.random() - 0.5) * 110;
        pos[i * 3 + 2] = (Math.random() - 0.5) * 90;

        const ratio = Math.random();
        const mixed = color1.clone().lerp(color2, ratio);
        col[i * 3] = mixed.r;
        col[i * 3 + 1] = mixed.g;
        col[i * 3 + 2] = mixed.b;
      }

      geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
      geo.setAttribute('color', new THREE.BufferAttribute(col, 3));

      const mat = new THREE.PointsMaterial({
        size: 1.8,
        vertexColors: true,
        transparent: true,
        opacity: 0.6,
        blending: THREE.AdditiveBlending
      });

      particleMesh = new THREE.Points(geo, mat);
      threeScene.add(particleMesh);

      window.addEventListener('resize', () => {
        threeCamera.aspect = window.innerWidth / window.innerHeight;
        threeCamera.updateProjectionMatrix();
        threeRenderer.setSize(window.innerWidth, window.innerHeight);
      });

      let mouseX = 0, mouseY = 0;
      window.addEventListener('mousemove', (e) => {
        mouseX = (e.clientX - window.innerWidth / 2) * 0.02;
        mouseY = (e.clientY - window.innerHeight / 2) * 0.02;
      });

      function animate() {
        requestAnimationFrame(animate);
        if (particleMesh) {
          particleMesh.rotation.y += 0.001;
          particleMesh.rotation.x += 0.0005;
          particleMesh.position.x += (mouseX - particleMesh.position.x) * 0.04;
          particleMesh.position.y += (-mouseY - particleMesh.position.y) * 0.04;
        }
        threeRenderer.render(threeScene, threeCamera);
      }
      animate();
    }

    // ==========================================================================
    // VIEW ROUTER (Cockpit, KTM Studio, Projector)
    // ==========================================================================
    function switchView(viewName) {
      State.activeView = viewName;
      document.querySelectorAll('.view-content-pane').forEach(p => p.classList.remove('active'));
      document.querySelectorAll('.rail-nav-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.m-dock-btn').forEach(b => b.classList.remove('active'));

      const targetPane = $(`view-${viewName}`);
      if (targetPane) targetPane.classList.add('active');

      const targetRailBtn = $(`railBtn${capitalize(viewName)}`);
      if (targetRailBtn) targetRailBtn.classList.add('active');

      if (viewName === 'cockpit') {
        if (!State.scanning) startScanner();
      } else {
        if (State.scanning) stopScanner();
      }

      if (viewName === 'ktm') {
        populateKtmDatalist();
      }

      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function capitalize(s) {
      return s.charAt(0).toUpperCase() + s.slice(1);
    }

    // ==========================================================================
    // KTM 3D FLIP MECHANISM
    // ==========================================================================
    function toggleCardFlip() {
      const box = $('ktmCardPreview');
      if (!box) return;
      State.isCardFlipped = !State.isCardFlipped;
      box.classList.toggle('flipped', State.isCardFlipped);
    }

    // ==========================================================================
    // THEME MANAGER (Executive, Emerald, Quantum, Light)
    // ==========================================================================
    function initTheme() {
      const saved = localStorage.getItem('smart_presensi_theme_cockpit') || 'executive';
      setExecutiveTheme(saved, false);
    }

    function setExecutiveTheme(themeName, save = true) {
      document.documentElement.setAttribute('data-theme', themeName);
      if (save) localStorage.setItem('smart_presensi_theme_cockpit', themeName);

      document.querySelectorAll('.theme-dot').forEach(dot => {
        dot.classList.remove('active');
        if (dot.classList.contains(`dot-${themeName.substring(0, 3)}`)) {
          dot.classList.add('active');
        }
      });
      showToast(`Tema: ${themeName.toUpperCase()}`, 'info', 1500);
    }

    // ==========================================================================
    // AUDIO SYNTHESIZER
    // ==========================================================================
    const AudioContext = window.AudioContext || window.webkitAudioContext;
    let audioCtx = null;

    function playBeep(type = 'success') {
      if (!State.audioEnabled) return;
      try {
        if (!audioCtx) audioCtx = new AudioContext();
        if (audioCtx.state === 'suspended') audioCtx.resume();

        const now = audioCtx.currentTime;

        if (type === 'success') {
          [523.25, 659.25, 783.99, 1046.50].forEach((freq, idx) => {
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.type = 'sine';
            osc.frequency.setValueAtTime(freq, now + idx * 0.05);

            gain.gain.setValueAtTime(0.07, now + idx * 0.05);
            gain.gain.exponentialRampToValueAtTime(0.0001, now + idx * 0.05 + 0.35);

            osc.connect(gain);
            gain.connect(audioCtx.destination);
            osc.start(now + idx * 0.05);
            osc.stop(now + idx * 0.05 + 0.35);
          });
        } else if (type === 'warning') {
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(330, now);
          osc.frequency.setValueAtTime(280, now + 0.1);
          gain.gain.setValueAtTime(0.12, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.25);
          osc.connect(gain);
          gain.connect(audioCtx.destination);
          osc.start(now);
          osc.stop(now + 0.25);
        } else {
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          osc.type = 'sawtooth';
          osc.frequency.setValueAtTime(180, now);
          osc.frequency.setValueAtTime(120, now + 0.15);
          gain.gain.setValueAtTime(0.12, now);
          gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.35);
          osc.connect(gain);
          gain.connect(audioCtx.destination);
          osc.start(now);
          osc.stop(now + 0.35);
        }
      } catch (e) {}
    }

    function toggleAudioFeedback() {
      State.audioEnabled = !State.audioEnabled;
      const icon = $('audioIcon');
      if (State.audioEnabled) {
        icon.className = 'fas fa-volume-up';
        showToast('🔊 Audio aktif', 'info', 2000);
        playBeep('success');
      } else {
        icon.className = 'fas fa-volume-mute';
        showToast('🔇 Audio bisu', 'info', 2000);
      }
    }

    // ==========================================================================
    // CLOCK & CALENDAR
    // ==========================================================================
    function updateClock() {
      const now = new Date();
      const h = String(now.getHours()).padStart(2, '0');
      const m = String(now.getMinutes()).padStart(2, '0');
      const s = String(now.getSeconds()).padStart(2, '0');
      if ($('liveClock')) $('liveClock').innerHTML = `${h}:${m}:<span style="color:var(--accent-light); font-weight:700;">${s}</span> WIB`;

      const options = { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' };
      if ($('liveDateStr')) $('liveDateStr').textContent = now.toLocaleDateString('id-ID', options);
    }
    setInterval(updateClock, 1000);
    updateClock();

    function todayStr() {
      const d = new Date();
      return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
    }

    function escapeHtml(s) {
      if (s == null) return '';
      return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#039;');
    }

    let toastTimer = null;
    function showToast(message, type = 'info', duration = 3500) {
      const bar = $('toastStrip');
      const text = $('toastText');
      const icon = $('toastIcon');
      if (!bar || !text) return;

      const icons = {
        success: 'fa-check-circle',
        error: 'fa-triangle-exclamation',
        warning: 'fa-circle-exclamation',
        info: 'fa-circle-info'
      };

      bar.className = `toast-strip-spatial ${type}`;
      icon.className = `fas ${icons[type] || 'fa-circle-info'}`;
      text.textContent = message;
      bar.style.display = 'flex';

      clearTimeout(toastTimer);
      if (duration > 0) {
        toastTimer = setTimeout(() => { bar.style.display = 'none'; }, duration);
      }
    }

    function setConnectionStatus(status, message) {
      const dot = $('statusDot');
      const label = $('statusLabel');
      if (!dot || !label) return;
      dot.className = 'pulse-dot ' + status;
      label.textContent = message;
      State.isOnline = (status === 'online');
    }

    // ==========================================================================
    // GOOGLE SHEETS API INTEGRATION & DATA SYNC
    // ==========================================================================
    async function apiGet(action, params = {}) {
      const qs = new URLSearchParams({ action, t: Date.now(), ...params });
      const res = await fetch(CONFIG.API_URL + '?' + qs.toString(), { method: 'GET', redirect: 'follow' });
      if (!res.ok) throw new Error('HTTP ' + res.status);
      return res.json();
    }

    async function apiPost(action, payload = {}) {
      const res = await fetch(CONFIG.API_URL, {
        method: 'POST',
        redirect: 'follow',
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify({ action, ...payload })
      });
      if (!res.ok) throw new Error('HTTP ' + res.status);
      return res.json();
    }

    function loadCacheMahasiswa() {
      try {
        const raw = localStorage.getItem(CONFIG.CACHE_KEY_MAHASISWA);
        return raw ? JSON.parse(raw) : [];
      } catch { return []; }
    }
    function saveCacheMahasiswa(data) {
      try { localStorage.setItem(CONFIG.CACHE_KEY_MAHASISWA, JSON.stringify(data)); } catch {}
    }

    function loadCachePresensi() {
      try {
        const raw = localStorage.getItem(CONFIG.CACHE_KEY_PRESENSI);
        if (!raw) return null;
        const parsed = JSON.parse(raw);
        if (parsed.tanggal !== todayStr()) return null;
        return parsed.map || {};
      } catch { return null; }
    }
    function saveCachePresensi(map) {
      try {
        localStorage.setItem(CONFIG.CACHE_KEY_PRESENSI, JSON.stringify({ tanggal: todayStr(), map }));
      } catch {}
    }

    function loadOfflineQueue() {
      try {
        const raw = localStorage.getItem(CONFIG.CACHE_KEY_OFFLINE_QUEUE);
        return raw ? JSON.parse(raw) : [];
      } catch { return []; }
    }
    function saveOfflineQueue(queue) {
      try { localStorage.setItem(CONFIG.CACHE_KEY_OFFLINE_QUEUE, JSON.stringify(queue)); } catch {}
    }

    async function checkConnection() {
      setConnectionStatus('checking', 'Mengecek server...');
      try {
        const json = await apiGet('ping');
        if (json.success) {
          setConnectionStatus('online', 'Terhubung ke Google Sheets');
          return true;
        }
        throw new Error(json.error || 'Ping gagal');
      } catch (err) {
        setConnectionStatus('offline', 'Mode Offline (Cache Aktif)');
        return false;
      }
    }

    async function loadAllData() {
      State.tanggalHariIni = todayStr();

      const cachedMhs = loadCacheMahasiswa();
      if (cachedMhs.length) {
        State.mahasiswa = cachedMhs;
        State.presensiHariIni = loadCachePresensi() || {};
        updateStats();
        renderTable();
        populateKtmDatalist();
      }

      const isOnline = await checkConnection();
      if (!isOnline) {
        if (!cachedMhs.length) showTableEmpty('offline');
        else showToast('Mode Offline: Memakai data tersimpan', 'warning', 3000);
        return;
      }

      try {
        const mhsRes = await apiGet('get_all');
        if (mhsRes.success && Array.isArray(mhsRes.data)) {
          State.mahasiswa = mhsRes.data;
          saveCacheMahasiswa(mhsRes.data);
        }

        const presRes = await apiGet('get_presensi', { tanggal: todayStr() });
        if (presRes.success && Array.isArray(presRes.data)) {
          const map = {};
          presRes.data.forEach(p => {
            if (p.nim) map[String(p.nim).trim()] = p;
          });
          State.presensiHariIni = map;
          saveCachePresensi(map);
        }

        updateStats();
        renderTable();
        populateKtmDatalist();
        showToast(`Sinkron sukses: ${State.mahasiswa.length} mahasiswa`, 'success', 2200);

        syncLocalQueue();
      } catch (err) {
        console.error('Sync Error:', err);
        if (State.mahasiswa.length) {
          showToast('Koneksi terhambat — memakai cache', 'warning', 3000);
          renderTable();
        } else {
          showTableEmpty('error', err.message);
        }
      }
    }

    async function syncLocalQueue() {
      const queue = loadOfflineQueue();
      if (!queue.length) return;

      showToast(`Menyinkronkan ${queue.length} presensi offline...`, 'info', 0);
      const remaining = [];

      for (const item of queue) {
        try {
          const res = await apiPost('presensi', item);
          if (res.success || res.already) {
            // Success
          } else {
            remaining.push(item);
          }
        } catch {
          remaining.push(item);
        }
      }

      saveOfflineQueue(remaining);
      if (remaining.length === 0) {
        showToast('Semua presensi offline berhasil diunggah!', 'success', 3500);
      }
      loadAllData();
    }

    // ==========================================================================
    // STATS & CIRCULAR RADIAL GAUGE
    // ==========================================================================
    function updateStats() {
      const total = State.mahasiswa.length;
      const hadir = Object.keys(State.presensiHariIni).length;
      const belum = Math.max(0, total - hadir);
      const persen = total > 0 ? Math.round((hadir / total) * 100) : 0;

      if ($('statTotalVal')) $('statTotalVal').textContent = total;
      if ($('statHadirVal')) $('statHadirVal').textContent = hadir;
      if ($('statBelumVal')) $('statBelumVal').textContent = belum;
      if ($('gaugePercentText')) $('gaugePercentText').textContent = `${persen}%`;

      if ($('pillCountAll')) $('pillCountAll').textContent = total;
      if ($('pillCountHadir')) $('pillCountHadir').textContent = hadir;
      if ($('pillCountBelum')) $('pillCountBelum').textContent = belum;

      // Update Radial SVG Circle (circumference = 2 * PI * 70 = 439.82)
      const circle = $('gaugeValCircle');
      if (circle) {
        const offset = 440 - (440 * (persen / 100));
        circle.style.strokeDashoffset = offset;
      }

      // Update Recent Stream Feed
      updateStreamFeed();
    }

    function updateStreamFeed() {
      const list = $('streamFeedList');
      if (!list) return;

      const hadirKeys = Object.keys(State.presensiHariIni);
      if (!hadirKeys.length) {
        list.innerHTML = `
          <div style="text-align: center; padding: 30px 10px; color: var(--text-muted); font-size: 12px;">
            <i class="fas fa-satellite-dish" style="font-size: 24px; opacity: 0.4; display: block; margin-bottom: 8px;"></i>
            Belum ada aktivitas presensi hari ini
          </div>`;
        return;
      }

      list.innerHTML = '';
      hadirKeys.slice(-6).reverse().forEach(nim => {
        const data = State.presensiHariIni[nim];
        const mhs = State.mahasiswa.find(m => String(m.nim).trim() === String(nim).trim()) || { nama: data.nama || nim };
        const initial = (mhs.nama || 'M').charAt(0).toUpperCase();

        const item = document.createElement('div');
        item.className = 'stream-item-chip';
        item.innerHTML = `
          <div class="stream-user">
            <div class="stream-avatar">${escapeHtml(initial)}</div>
            <div>
              <strong style="color:var(--text-main);">${escapeHtml(mhs.nama)}</strong>
              <div style="font-size:10px; color:var(--text-muted);">${escapeHtml(nim)}</div>
            </div>
          </div>
          <span style="font-family:var(--font-mono); font-size:11px; color:var(--accent-light);">
            ${escapeHtml(data.waktu ? data.waktu.split(' ')[1] || data.waktu : 'Hadir')}
          </span>
        `;
        list.appendChild(item);
      });
    }

