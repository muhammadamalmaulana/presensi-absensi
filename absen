        const jurusan = String(m.jurusan || '').toLowerCase();
        const matchSearch = nim.includes(State.searchQuery) || nama.includes(State.searchQuery) || kelas.includes(State.searchQuery) || jurusan.includes(State.searchQuery);

        const isHadir = !!State.presensiHariIni[String(m.nim || '').trim()];
        if (State.currentFilter === 'hadir') return matchSearch && isHadir;
        if (State.currentFilter === 'belum') return matchSearch && !isHadir;
