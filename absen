<!DOCTYPE html>
<html lang="id" data-theme="executive">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Smart Presensi 3D Command Deck &bull; Enterprise Attendance System</title>
  
  <!-- Premium Modern Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Outfit:wght@500;600;700;800;900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- Font Awesome 6.5.1 -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  
  <!-- Three.js (WebGL 3D Spatial Engine) -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

  <!-- HTML5 QR Code Library -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html5-qrcode/2.3.8/html5-qrcode.min.js"></script>
  
  <!-- Canvas Confetti -->
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.2/dist/confetti.browser.min.js"></script>

  <style>
    /* ==========================================================================
       RADICAL NEW SHAPE: SPATIAL COMMAND DECK (Sidebar Dock + Cockpit Layout)
       ========================================================================== */
    :root {
      --font-heading: 'Outfit', sans-serif;
      --font-body: 'Plus Jakarta Sans', sans-serif;
      --font-mono: 'JetBrains Mono', monospace;

      /* THEME: EXECUTIVE TITANIUM */
      --bg-base: #060912;
      --bg-gradient: radial-gradient(circle at 60% -10%, #161c33 0%, #080d1a 45%, #03050a 100%);
      
      --deck-sidebar: rgba(11, 17, 34, 0.88);
      --card-bg: rgba(14, 21, 40, 0.75);
      --card-border: rgba(99, 102, 241, 0.22);
      --card-border-glow: rgba(99, 102, 241, 0.55);
      --card-shadow: 
        0 24px 60px -15px rgba(0, 0, 0, 0.85),
        0 0 35px rgba(99, 102, 241, 0.12),
        inset 0 1px 1px rgba(255, 255, 255, 0.16);

      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --text-subtle: #475569;

      --primary: #6366f1;
      --primary-light: #818cf8;
      --primary-gradient: linear-gradient(135deg, #6366f1 0%, #4338ca 100%);
      --primary-glow: rgba(99, 102, 241, 0.45);

      --accent: #10b981;
      --accent-light: #34d399;
      --accent-gradient: linear-gradient(135deg, #10b981 0%, #059669 100%);
      --accent-glow: rgba(16, 185, 129, 0.45);

      --warning: #f59e0b;
      --danger: #ef4444;
      --cyan: #06b6d4;

      --surface-glass: rgba(17, 24, 45, 0.65);
      --surface-hover: rgba(255, 255, 255, 0.06);
      --bevel-top: rgba(255, 255, 255, 0.14);

      --radius-sm: 10px;
      --radius-md: 16px;
      --radius-lg: 24px;
      --radius-xl: 32px;
    }

    [data-theme="emerald"] {
      --bg-base: #030b08;
      --bg-gradient: radial-gradient(circle at 60% -10%, #0b3325 0%, #04140e 50%, #020705 100%);
      --deck-sidebar: rgba(4, 20, 14, 0.88);
      --card-bg: rgba(6, 26, 18, 0.75);
      --card-border: rgba(16, 185, 129, 0.28);
      --card-border-glow: rgba(16, 185, 129, 0.6);
      --primary: #10b981;
      --primary-light: #34d399;
      --primary-gradient: linear-gradient(135deg, #10b981 0%, #047857 100%);
      --primary-glow: rgba(16, 185, 129, 0.5);
      --accent: #06b6d4;
      --accent-light: #22d3ee;
      --accent-gradient: linear-gradient(135deg, #06b6d4 0%, #0284c7 100%);
      --accent-glow: rgba(6, 182, 212, 0.4);
    }

    [data-theme="quantum"] {
      --bg-base: #090514;
      --bg-gradient: radial-gradient(circle at 60% -10%, #2a1452 0%, #0f0724 50%, #05020c 100%);
      --deck-sidebar: rgba(18, 10, 36, 0.88);
      --card-bg: rgba(22, 12, 45, 0.75);
      --card-border: rgba(168, 85, 247, 0.28);
      --card-border-glow: rgba(168, 85, 247, 0.6);
      --primary: #a855f7;
      --primary-light: #c084fc;
      --primary-gradient: linear-gradient(135deg, #a855f7 0%, #7e22ce 100%);
      --primary-glow: rgba(168, 85, 247, 0.5);
      --accent: #ec4899;
      --accent-light: #f472b6;
      --accent-gradient: linear-gradient(135deg, #ec4899 0%, #be185d 100%);
      --accent-glow: rgba(236, 72, 153, 0.4);
    }

    [data-theme="light"] {
      --bg-base: #f0f4f9;
      --bg-gradient: radial-gradient(circle at 60% -10%, #e0e7ff 0%, #f1f5f9 50%, #e2e8f0 100%);
      --deck-sidebar: rgba(255, 255, 255, 0.95);
      --card-bg: rgba(255, 255, 255, 0.88);
      --card-border: rgba(226, 232, 240, 0.95);
      --card-border-glow: rgba(99, 102, 241, 0.45);
      --text-main: #0f172a;
      --text-muted: #475569;
      --text-subtle: #94a3b8;
      --primary: #4f46e5;
      --primary-light: #6366f1;
      --primary-gradient: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%);
      --primary-glow: rgba(79, 70, 229, 0.35);
      --accent: #059669;
      --accent-light: #10b981;
      --accent-gradient: linear-gradient(135deg, #059669 0%, #047857 100%);
      --accent-glow: rgba(5, 150, 105, 0.35);
      --surface-glass: rgba(248, 250, 252, 0.85);
      --surface-hover: rgba(0, 0, 0, 0.04);
      --bevel-top: rgba(255, 255, 255, 0.8);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      font-family: var(--font-body);
      background-color: var(--bg-base);
      background-image: var(--bg-gradient);
      background-attachment: fixed;
      color: var(--text-main);
      min-height: 100vh;
      overflow-x: hidden;
      display: flex;
      justify-content: center;
      transition: background 0.4s ease, color 0.4s ease;
    }

    /* WebGL 3D Background Canvas */
    #webgl-canvas {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      z-index: 0;
      pointer-events: none;
      opacity: 0.65;
    }

    /* ==========================================================================
       APP SPATIAL COCKPIT LAYOUT (SIDEBAR + MAIN CANVAS)
       ========================================================================== */
    .cockpit-wrapper {
      position: relative;
      z-index: 2;
      width: 100%;
      max-width: 1440px;
      min-height: 100vh;
      display: flex;
      padding: 20px;
      gap: 20px;
    }

    /* 3D Glass Sidebar Rail */
    .sidebar-rail {
      width: 82px;
      background: var(--deck-sidebar);
      backdrop-filter: blur(28px) saturate(180%);
      -webkit-backdrop-filter: blur(28px) saturate(180%);
      border: 1px solid var(--card-border);
      border-radius: var(--radius-xl);
      padding: 24px 12px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      box-shadow: var(--card-shadow);
      flex-shrink: 0;
      position: sticky;
      top: 20px;
      height: calc(100vh - 40px);
      z-index: 50;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .rail-brand {
      width: 48px;
      height: 48px;
      border-radius: 16px;
      background: var(--primary-gradient);
      box-shadow: 0 8px 24px var(--primary-glow);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
      color: #fff;
      cursor: pointer;
      position: relative;
      overflow: hidden;
      transform: perspective(400px) rotateY(-8deg);
      transition: transform 0.3s ease;
    }
    .rail-brand:hover {
      transform: perspective(400px) rotateY(12deg) scale(1.08);
    }
    .rail-brand::before {
      content: '';
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background: linear-gradient(45deg, transparent, rgba(255, 255, 255, 0.5), transparent);
      transform: rotate(45deg);
      animation: brandGlint 4s infinite linear;
    }
    @keyframes brandGlint {
      0% { transform: translateX(-100%) rotate(45deg); }
      20%, 100% { transform: translateX(100%) rotate(45deg); }
    }

    /* Sidebar Navigation Pills */
    .rail-nav-group {
      display: flex;
      flex-direction: column;
      gap: 16px;
      align-items: center;
      width: 100%;
    }

    .rail-nav-btn {
      width: 50px;
      height: 50px;
      border-radius: 16px;
      border: 1px solid transparent;
      background: transparent;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      cursor: pointer;
      position: relative;
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .rail-nav-btn:hover {
      background: var(--surface-hover);
      color: var(--text-main);
      transform: translateY(-2px);
    }
    .rail-nav-btn.active {
      background: var(--primary-gradient);
      color: #ffffff;
      border-color: rgba(255, 255, 255, 0.25);
      box-shadow: 0 6px 20px var(--primary-glow);
      transform: scale(1.06);
    }
    .rail-nav-btn .nav-tooltip {
      position: absolute;
      left: 68px;
      background: #090e1a;
      border: 1px solid var(--primary);
      color: #fff;
      padding: 5px 12px;
      border-radius: 8px;
      font-size: 11px;
      font-weight: 700;
      white-space: nowrap;
      pointer-events: none;
      opacity: 0;
      transform: translateX(-10px);
      transition: all 0.2s ease;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.6);
      z-index: 100;
    }
    .rail-nav-btn:hover .nav-tooltip {
      opacity: 1;
      transform: translateX(0);
    }

    /* Main Deck Stage */
    .deck-stage {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 20px;
      min-width: 0;
    }

    /* Top Floating Island */
    .top-command-island {
      background: var(--card-bg);
      backdrop-filter: blur(28px) saturate(180%);
      -webkit-backdrop-filter: blur(28px) saturate(180%);
      border: 1px solid var(--card-border);
      border-radius: var(--radius-xl);
      padding: 14px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      box-shadow: var(--card-shadow);
      position: relative;
      overflow: hidden;
    }
    .top-command-island::after {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 2px;
      background: linear-gradient(90deg, transparent, var(--primary), var(--accent), transparent);
    }

    .island-title h1 {
      font-family: var(--font-heading);
      font-size: 20px;
      font-weight: 800;
      letter-spacing: -0.4px;
      color: var(--text-main);
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .tag-pro-pill {
      font-family: var(--font-mono);
      font-size: 10px;
      font-weight: 700;
      padding: 3px 8px;
      border-radius: 20px;
      background: rgba(99, 102, 241, 0.16);
      border: 1px solid var(--primary);
      color: var(--primary-light);
    }
    .island-time {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      gap: 6px;
      margin-top: 2px;
    }

    .island-controls {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .status-capsule {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 7px 14px;
      border-radius: 30px;
      background: var(--surface-glass);
      border: 1px solid var(--card-border);
      font-size: 11px;
      font-weight: 600;
      color: var(--text-muted);
    }
    .pulse-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--warning);
      box-shadow: 0 0 10px var(--warning);
      animation: pulse 2s infinite;
    }
    .pulse-dot.online { background: var(--accent); box-shadow: 0 0 12px var(--accent); }
    .pulse-dot.offline { background: var(--danger); box-shadow: 0 0 12px var(--danger); }
    @keyframes pulse {
      0%, 100% { transform: scale(0.9); opacity: 0.8; }
      50% { transform: scale(1.2); opacity: 1; }
    }

    /* 4-Theme Color Dots */
    .theme-palette-dots {
      display: flex;
      align-items: center;
      background: var(--surface-glass);
      border: 1px solid var(--card-border);
      border-radius: 30px;
      padding: 4px 6px;
      gap: 4px;
    }
    .theme-dot {
      width: 20px;
      height: 20px;
      border-radius: 50%;
      border: 2px solid transparent;
      cursor: pointer;
      transition: all 0.2s;
    }
    .theme-dot:hover { transform: scale(1.2); }
    .theme-dot.active { border-color: #fff; box-shadow: 0 0 10px var(--primary); transform: scale(1.15); }
    .dot-exec { background: linear-gradient(135deg, #6366f1, #10b981); }
    .dot-emr  { background: linear-gradient(135deg, #10b981, #06b6d4); }
    .dot-qtm  { background: linear-gradient(135deg, #a855f7, #ec4899); }
    .dot-lgt  { background: linear-gradient(135deg, #f8fafc, #94a3b8); }

    /* Tactile 3D Buttons */
    .btn-tactile-3d {
      border: none;
      background: var(--surface-glass);
      color: var(--text-main);
      padding: 9px 18px;
      border-radius: var(--radius-sm);
      font-family: var(--font-body);
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      position: relative;
      text-decoration: none;
      border: 1px solid var(--card-border);
      box-shadow: 
        0 4px 0 rgba(0, 0, 0, 0.4),
        0 8px 18px rgba(0, 0, 0, 0.3),
        inset 0 1px 1px var(--bevel-top);
      transform: translateY(0);
      transition: all 0.15s cubic-bezier(0.16, 1, 0.3, 1);
      user-select: none;
    }
    .btn-tactile-3d:hover {
      background: var(--surface-hover);
      border-color: var(--primary);
      transform: translateY(-2px);
      box-shadow: 0 6px 0 rgba(0, 0, 0, 0.45), 0 12px 22px rgba(0, 0, 0, 0.4);
    }
    .btn-tactile-3d:active {
      transform: translateY(3px);
      box-shadow: 0 1px 0 rgba(0, 0, 0, 0.4), 0 2px 6px rgba(0, 0, 0, 0.3);
    }
    .btn-primary-gradient {
      background: var(--primary-gradient);
      color: #fff;
      border-color: rgba(255, 255, 255, 0.2);
      box-shadow: 0 5px 0 rgba(30, 27, 75, 0.8), 0 10px 25px var(--primary-glow);
    }
    .btn-stop-danger {
      background: linear-gradient(135deg, #ef4444 0%, #b91c1c 100%) !important;
      box-shadow: 0 5px 0 #7f1d1d !important;
      color: #fff !important;
    }
    .btn-icon-box {
      width: 40px;
      height: 40px;
      padding: 0;
      font-size: 14px;
    }

    /* Toast Notification Strip */
    .toast-strip-spatial {
      display: none;
      padding: 12px 20px;
      border-radius: var(--radius-md);
      font-size: 13px;
      font-weight: 600;
      align-items: center;
      gap: 12px;
      backdrop-filter: blur(20px);
      box-shadow: var(--card-shadow);
      animation: toastDrop 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      border: 1px solid transparent;
    }
    @keyframes toastDrop {
      from { opacity: 0; transform: translateY(-10px) scale(0.96); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }
    .toast-strip-spatial.success { display: flex; background: rgba(16, 185, 129, 0.16); color: #10b981; border-color: rgba(16, 185, 129, 0.35); }
    .toast-strip-spatial.error { display: flex; background: rgba(239, 68, 68, 0.16); color: #f87171; border-color: rgba(239, 68, 68, 0.35); }
    .toast-strip-spatial.warning { display: flex; background: rgba(245, 158, 11, 0.16); color: #fbbf24; border-color: rgba(245, 158, 11, 0.35); }
    .toast-strip-spatial.info { display: flex; background: rgba(99, 102, 241, 0.16); color: #818cf8; border-color: rgba(99, 102, 241, 0.35); }

    /* ==========================================================================
       VIEW CONTAINER & PAGE ROUTING
       ========================================================================== */
    .view-content-pane {
      display: none;
      flex-direction: column;
      gap: 20px;
      animation: viewFade 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    .view-content-pane.active {
      display: flex;
    }
    @keyframes viewFade {
      from { opacity: 0; transform: translateY(12px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* ==========================================================================
       RADICAL VIEW 1: SPATIAL COCKPIT COMMAND (3-PILLAR HERO + DATA MATRIX)
       ========================================================================== */
    .cockpit-hero-grid {
      display: grid;
      grid-template-columns: 290px 1fr 310px;
      gap: 20px;
      align-items: stretch;
    }

    @media (max-width: 1200px) {
      .cockpit-hero-grid {
        grid-template-columns: 1fr 1fr;
      }
      .hero-pillar-stream {
        grid-column: span 2;
      }
    }
    @media (max-width: 768px) {
      .cockpit-hero-grid {
        grid-template-columns: 1fr;
      }
      .hero-pillar-stream {
        grid-column: span 1;
      }
    }

    /* Common Spatial Glass Card */
    .spatial-card {
      background: var(--card-bg);
      backdrop-filter: blur(28px) saturate(180%);
      -webkit-backdrop-filter: blur(28px) saturate(180%);
      border: 1px solid var(--card-border);
      border-radius: var(--radius-xl);
      padding: 22px;
      box-shadow: var(--card-shadow);
      display: flex;
      flex-direction: column;
      gap: 18px;
      position: relative;
      overflow: hidden;
      transition: all 0.25s ease;
    }
    .spatial-card:hover {
      border-color: var(--card-border-glow);
      box-shadow: 
        0 25px 60px -10px rgba(0, 0, 0, 0.85),
        0 0 35px var(--primary-glow);
    }

    /* PILLAR 1: RADIAL CIRCULAR GAUGE WIDGET */
    .hero-pillar-gauge {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      gap: 14px;
    }

    .radial-gauge-wrapper {
      position: relative;
      width: 160px;
      height: 160px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .radial-gauge-svg {
      width: 100%;
      height: 100%;
      transform: rotate(-90deg);
    }
    .gauge-bg-circle {
      fill: none;
      stroke: rgba(255, 255, 255, 0.08);
      stroke-width: 12;
    }
    .gauge-val-circle {
      fill: none;
      stroke: url(#gaugeGradient);
      stroke-width: 12;
      stroke-linecap: round;
      stroke-dasharray: 440;
      stroke-dashoffset: 440;
      transition: stroke-dashoffset 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .gauge-center-text {
      position: absolute;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .gauge-percent {
      font-family: var(--font-heading);
      font-size: 32px;
      font-weight: 900;
      color: var(--text-main);
      line-height: 1;
    }
    .gauge-label {
      font-size: 10px;
      font-weight: 700;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.8px;
      margin-top: 4px;
    }

    .gauge-metrics-trio {
      width: 100%;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
      background: var(--surface-glass);
      border: 1px solid var(--card-border);
      border-radius: var(--radius-md);
      padding: 10px 6px;
      text-align: center;
    }
    .gm-item span {
      display: block;
      font-size: 9px;
      color: var(--text-muted);
      font-weight: 700;
      text-transform: uppercase;
    }
    .gm-item strong {
      font-family: var(--font-heading);
      font-size: 18px;
      font-weight: 800;
      color: var(--text-main);
    }

    /* PILLAR 2: CURVED BIOMETRIC SCANNER VISOR */
    .hero-pillar-scanner {
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .scanner-visor-pod {
      position: relative;
      background: #020611;
      border-radius: var(--radius-lg);
      overflow: hidden;
      border: 1.5px solid var(--card-border);
      box-shadow: 
        inset 0 0 50px rgba(0, 0, 0, 0.9),
        0 15px 40px rgba(0, 0, 0, 0.6),
        0 0 30px var(--primary-glow);
      min-height: 250px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    #qr-reader {
      width: 100% !important;
      min-height: 250px;
      background: #020611;
      border: none !important;
    }
    #qr-reader video {
      width: 100% !important;
      height: 100% !important;
      object-fit: cover !important;
      border-radius: var(--radius-lg) !important;
      display: block !important;
    }
    #qr-reader > div:not(:first-child) { display: none !important; }

    /* Precision Targeting Viewfinder Overlay */
    .precision-targeting-hud {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 10;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    .radar-ring-outer {
      position: absolute;
      width: 230px;
      height: 230px;
      border-radius: 50%;
      border: 1px dashed rgba(255, 255, 255, 0.2);
      animation: radarSpin 22s linear infinite;
    }
    .radar-ring-inner {
      position: absolute;
      width: 200px;
      height: 200px;
      border-radius: 50%;
      border: 1px dotted var(--primary);
      opacity: 0.5;
      animation: radarSpinRev 16s linear infinite;
    }
    @keyframes radarSpin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
    @keyframes radarSpinRev { 0% { transform: rotate(360deg); } 100% { transform: rotate(0deg); } }

    .reticle-box-pod {
      position: relative;
      width: 180px;
      height: 180px;
      border-radius: 18px;
      box-shadow: 0 0 0 9999px rgba(3, 7, 18, 0.65);
      border: 1px solid rgba(255, 255, 255, 0.18);
    }
    .reticle-bracket {
      position: absolute;
      width: 24px;
      height: 24px;
      border-color: var(--primary-light);
      border-style: solid;
      border-width: 0;
      filter: drop-shadow(0 0 8px var(--primary));
    }
    .rb-tl { top: -2px; left: -2px; border-top-width: 4px; border-left-width: 4px; border-radius: 8px 0 0 0; }
    .rb-tr { top: -2px; right: -2px; border-top-width: 4px; border-right-width: 4px; border-radius: 0 8px 0 0; }
    .rb-bl { bottom: -2px; left: -2px; border-bottom-width: 4px; border-left-width: 4px; border-radius: 0 0 0 8px; }
    .rb-br { bottom: -2px; right: -2px; border-bottom-width: 4px; border-right-width: 4px; border-radius: 0 0 8px 0; }

    .scanner-sweep-line {
      position: absolute;
      left: 8px;
      right: 8px;
      height: 3px;
      background: linear-gradient(90deg, transparent, var(--primary-light), #fff, var(--accent-light), transparent);
      box-shadow: 0 0 16px var(--primary-light), 0 0 32px var(--accent-light);
      animation: laserSweep 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
      border-radius: 4px;
    }
    @keyframes laserSweep {
      0% { top: 10px; opacity: 0.7; }
      50% { top: 165px; opacity: 1; }
      100% { top: 10px; opacity: 0.7; }
    }

    .pod-status-badge {
      position: absolute;
      bottom: 12px;
      padding: 5px 14px;
      background: rgba(6, 10, 22, 0.85);
      backdrop-filter: blur(12px);
      border: 1px solid var(--card-border);
      border-radius: 30px;
      font-size: 11px;
      font-weight: 700;
      color: #fff;
      display: flex;
      align-items: center;
      gap: 7px;
    }

    /* Visor Controls */
    .visor-toolbar {
      display: grid;
      grid-template-columns: 1fr auto auto auto;
      gap: 10px;
    }
    .fast-punch-bar {
      display: flex;
      gap: 8px;
      background: var(--surface-glass);
      border: 1px solid var(--card-border);
      border-radius: var(--radius-sm);
      padding: 5px;
    }
    .fast-punch-input {
      flex: 1;
      background: transparent;
      border: none;
      padding: 6px 10px;
      color: var(--text-main);
      font-family: var(--font-mono);
      font-size: 12px;
    }
    .fast-punch-input:focus { outline: none; }
    .fast-punch-input::placeholder { color: var(--text-subtle); }

    /* PILLAR 3: LIVE RECENT ATTENDANCE STREAM */
    .hero-pillar-stream {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .stream-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 12px;
      font-weight: 700;
      color: var(--text-muted);
    }
    .stream-feed-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
      max-height: 280px;
      overflow-y: auto;
    }
    .stream-feed-list::-webkit-scrollbar { width: 4px; }
    .stream-feed-list::-webkit-scrollbar-thumb { background: var(--card-border); border-radius: 4px; }

    .stream-item-chip {
      background: var(--surface-glass);
      border: 1px solid var(--card-border);
      border-radius: var(--radius-sm);
      padding: 8px 12px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 12px;
      transition: background 0.2s;
    }
    .stream-item-chip:hover {
      background: var(--surface-hover);
      border-color: var(--primary);
    }
    .stream-user {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .stream-avatar {
      width: 26px;
      height: 26px;
      border-radius: 8px;
      background: var(--primary-gradient);
      color: #fff;
      font-family: var(--font-heading);
      font-size: 11px;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* BOTTOM DATA MATRIX (TABLE & CONTROLS) */
    .data-matrix-box {
      background: var(--card-bg);
      backdrop-filter: blur(28px) saturate(180%);
      -webkit-backdrop-filter: blur(28px) saturate(180%);
      border: 1px solid var(--card-border);
      border-radius: var(--radius-xl);
      padding: 22px;
      box-shadow: var(--card-shadow);
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .matrix-top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
    }
    .matrix-search-box {
      flex: 1;
      max-width: 420px;
      position: relative;
      display: flex;
      align-items: center;
    }
    .matrix-search-box i {
      position: absolute;
      left: 14px;
      color: var(--primary-light);
      font-size: 13px;
    }
    .matrix-search-input {
      width: 100%;
      padding: 10px 14px 10px 40px;
      background: var(--surface-glass);
      border: 1px solid var(--card-border);
      border-radius: var(--radius-sm);
      color: var(--text-main);
      font-family: var(--font-body);
      font-size: 12px;
      box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.3);
      transition: all 0.2s;
    }
    .matrix-search-input:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 15px var(--primary-glow);
    }

    .matrix-filters {
      display: flex;
      gap: 8px;
    }
    .m-pill {
      padding: 6px 14px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 700;
      border: 1px solid var(--card-border);
      background: var(--surface-glass);
      color: var(--text-muted);
      cursor: pointer;
      transition: all 0.2s;
    }
    .m-pill:hover { background: var(--surface-hover); color: var(--text-main); }
    .m-pill.active {
      background: var(--primary-gradient);
      color: #fff;
      border-color: var(--primary);
      box-shadow: 0 0 15px var(--primary-glow);
    }

    .matrix-scroll-wrapper {
      background: var(--surface-glass);
      border: 1px solid var(--card-border);
      border-radius: var(--radius-md);
      overflow: hidden;
      max-height: 420px;
      overflow-y: auto;
    }
    .matrix-scroll-wrapper::-webkit-scrollbar { width: 5px; }
    .matrix-scroll-wrapper::-webkit-scrollbar-thumb { background: var(--primary); border-radius: 4px; }

    table.matrix-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 12px;
    }
    table.matrix-table th {
      padding: 12px 14px;
      background: var(--card-bg);
      color: var(--text-muted);
      font-weight: 700;
      text-transform: uppercase;
      font-size: 10px;
      letter-spacing: 0.8px;
      position: sticky;
      top: 0;
      backdrop-filter: blur(10px);
      z-index: 5;
      border-bottom: 1px solid var(--card-border);
    }
    table.matrix-table td {
      padding: 12px 14px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      color: var(--text-main);
      vertical-align: middle;
      transition: background 0.2s;
    }
    table.matrix-table tr:hover td {
      background: rgba(99, 102, 241, 0.05);
    }

    .user-flex-cell {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .avatar-cell-3d {
      width: 32px;
      height: 32px;
      border-radius: 10px;
      background: var(--primary-gradient);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: 13px;
    }

    .chip-status-3d {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 10px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 700;
    }
    .chip-status-3d.hadir {
      background: rgba(16, 185, 129, 0.15);
      color: #10b981;
      border: 1px solid rgba(16, 185, 129, 0.4);
    }
    .chip-status-3d.belum {
      background: rgba(148, 163, 184, 0.1);
      color: var(--text-muted);
      border: 1px solid rgba(148, 163, 184, 0.2);
    }

    /* ==========================================================================
       VIEW 2: KTM 3D STUDIO (REAL 3D FLIP CARD)
       ========================================================================== */
    .ktm-studio-stage {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 20px;
      padding: 20px 0;
    }

    .ktm-card-3d-box {
      position: relative;
      width: 100%;
      max-width: 480px;
      height: 270px;
      perspective: 1200px;
      cursor: pointer;
    }
    .ktm-inner-flip {
      position: relative;
      width: 100%;
      height: 100%;
      transform-style: preserve-3d;
      transition: transform 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
      border-radius: 20px;
    }
    .ktm-card-3d-box.flipped .ktm-inner-flip {
      transform: rotateY(180deg);
    }

    .ktm-face {
      position: absolute;
      width: 100%;
      height: 100%;
      border-radius: 20px;
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
      padding: 22px 24px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      overflow: hidden;
      box-shadow: 
        0 25px 50px rgba(0, 0, 0, 0.85),
        0 0 35px var(--primary-glow),
        inset 0 1px 2px rgba(255, 255, 255, 0.4);
      border: 1.5px solid rgba(255, 255, 255, 0.2);
    }

    .ktm-front {
      background: linear-gradient(135deg, #0b1120 0%, #1e1b4b 50%, #064e3b 100%);
    }
    .ktm-front::after {
      content: '';
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background: linear-gradient(
        115deg,
        transparent 25%,
        rgba(255, 255, 255, 0.1) 40%,
        rgba(99, 102, 241, 0.2) 48%,
        rgba(255, 255, 255, 0.3) 52%,
        transparent 65%
      );
      transform: rotate(30deg);
      pointer-events: none;
      animation: cardShimmer 7s infinite linear;
    }
    @keyframes cardShimmer {
      0% { transform: translateY(-100%) rotate(30deg); }
      100% { transform: translateY(100%) rotate(30deg); }
    }

    .ktm-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      z-index: 2;
    }
    .ktm-univ-h3 {
      font-family: var(--font-heading);
      font-size: 15px;
      font-weight: 800;
      letter-spacing: 0.5px;
      color: #fff;
    }
    .ktm-univ-sub {
      font-size: 10px;
      color: var(--primary-light);
      font-family: var(--font-mono);
      letter-spacing: 1px;
    }

    .ktm-gold-microchip {
      width: 38px;
      height: 28px;
      background: linear-gradient(135deg, #fbbf24 0%, #d97706 100%);
      border-radius: 6px;
      border: 1px solid rgba(255, 255, 255, 0.5);
      box-shadow: inset 0 0 5px rgba(0, 0, 0, 0.6);
      position: relative;
    }
    .ktm-gold-microchip::before {
      content: '';
      position: absolute;
      top: 50%;
      left: 0;
      width: 100%;
      height: 1px;
      background: rgba(0, 0, 0, 0.4);
    }
    .ktm-gold-microchip::after {
      content: '';
      position: absolute;
      top: 0;
      left: 50%;
      width: 1px;
      height: 100%;
      background: rgba(0, 0, 0, 0.4);
    }

    .ktm-mid {
      display: flex;
      align-items: center;
      gap: 16px;
      z-index: 2;
    }
    .ktm-avatar-sq {
      width: 70px;
      height: 70px;
      border-radius: 16px;
      background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
      border: 2px solid #fff;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.5);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-heading);
      font-size: 30px;
      font-weight: 800;
      color: #fff;
    }

    .ktm-data-block { flex: 1; }
    .ktm-data-block .name {
      font-family: var(--font-heading);
      font-size: 16px;
      font-weight: 800;
      color: #fff;
    }
    .ktm-data-block .nim {
      font-family: var(--font-mono);
      font-size: 13px;
      font-weight: 700;
      color: var(--accent-light);
      margin-top: 2px;
    }
    .ktm-data-block .dept {
      font-size: 11px;
      color: rgba(255, 255, 255, 0.85);
      margin-top: 2px;
    }

    .ktm-qr-white {
      padding: 6px;
      background: #ffffff;
      border-radius: 12px;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.5);
    }
    .ktm-qr-white img {
      display: block;
      width: 74px;
      height: 74px;
      border-radius: 6px;
    }

    .ktm-btm {
      display: flex;
      justify-content: space-between;
      font-size: 9px;
      color: rgba(255, 255, 255, 0.6);
      font-family: var(--font-mono);
      letter-spacing: 0.5px;
      z-index: 2;
    }

    /* BACK FACE */
    .ktm-back {
      background: linear-gradient(135deg, #090d16 0%, #151b2e 100%);
      transform: rotateY(180deg);
      padding: 20px 24px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    .mag-stripe-black {
      width: calc(100% + 48px);
      margin: -20px -24px 10px -24px;
      height: 42px;
      background: #020408;
      border-top: 1px solid rgba(255,255,255,0.1);
      border-bottom: 1px solid rgba(255,255,255,0.1);
    }
    .barcode-block {
      background: #ffffff;
      padding: 6px 12px;
      border-radius: 8px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
    }
    .barcode-lines {
      width: 100%;
      height: 24px;
      background: repeating-linear-gradient(90deg, #000 0px, #000 2px, transparent 2px, transparent 4px, #000 4px, #000 7px, transparent 7px, transparent 8px);
    }

    /* ==========================================================================
       VIEW 3: AUDITORIUM PROJECTOR STAGE
       ========================================================================== */
    .projector-stage-box {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 20px;
      text-align: center;
      padding: 30px;
    }
    .big-qr-floating-frame {
      padding: 20px;
      background: #ffffff;
      border-radius: 28px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.8), 0 0 50px var(--primary-glow);
    }
    .big-qr-floating-frame img {
      display: block;
      width: 260px;
      height: 260px;
      border-radius: 16px;
    }

    /* ==========================================================================
       POPUP MODAL PRESENSI BERHASIL
       ========================================================================== */
    .modal-backdrop-spatial {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(4, 7, 18, 0.8);
      backdrop-filter: blur(16px);
      z-index: 1000;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
      perspective: 1200px;
    }
    .modal-backdrop-spatial.show {
      display: flex;
      animation: modalFade 0.25s ease;
    }
    @keyframes modalFade { from { opacity: 0; } to { opacity: 1; } }

    .modal-card-spatial {
      background: var(--card-bg);
      border: 1.5px solid var(--primary);
      border-radius: var(--radius-xl);
      padding: 30px;
      max-width: 440px;
      width: 100%;
      text-align: center;
      box-shadow: 0 30px 70px rgba(0, 0, 0, 0.9), 0 0 50px var(--primary-glow);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 18px;
      animation: modalPop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    @keyframes modalPop {
      0% { transform: scale(0.7) rotateX(20deg) translateZ(-80px); opacity: 0; }
      100% { transform: scale(1) rotateX(0deg) translateZ(0); opacity: 1; }
    }
    .modal-trophy-circle {
      width: 76px;
      height: 76px;
      border-radius: 50%;
      background: var(--accent-gradient);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 36px;
      box-shadow: 0 10px 30px var(--accent-glow);
    }

    /* Mobile Bottom Dock */
    .mobile-bottom-bar {
      position: fixed;
      bottom: 0;
      left: 0;
      width: 100%;
      background: var(--card-bg);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-top: 1px solid var(--card-border);
      padding: 8px 12px;
      display: none;
      justify-content: space-around;
      align-items: center;
      z-index: 100;
      box-shadow: 0 -10px 30px rgba(0, 0, 0, 0.6);
    }
    @media (max-width: 992px) {
      .sidebar-rail { display: none; }
      .mobile-bottom-bar { display: flex; }
      .cockpit-wrapper { padding: 12px 12px 85px 12px; }
    }
    .m-dock-btn {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
      color: var(--text-muted);
      font-size: 10px;
      font-weight: 700;
      background: transparent;
      border: none;
      padding: 6px 12px;
      border-radius: 12px;
      cursor: pointer;
    }
    .m-dock-btn i { font-size: 18px; }
    .m-dock-btn.active { color: var(--primary-light); }
    .m-dock-btn.fab-center {
      background: var(--primary-gradient);
      color: #fff !important;
      border-radius: 50%;
      width: 50px;
      height: 50px;
      margin-top: -25px;
      box-shadow: 0 8px 25px var(--primary-glow);
      display: flex;
      align-items: center;
      justify-content: center;
    }
  </style>
</head>
<body>

  <!-- Three.js Spatial WebGL Canvas -->
  <canvas id="webgl-canvas"></canvas>

  <!-- Cockpit Container -->
  <div class="cockpit-wrapper">
    
    <!-- 3D Glass Sidebar Rail -->
    <aside class="sidebar-rail">
      <div class="rail-brand" title="Smart Presensi 3D Cockpit" onclick="switchView('cockpit')">
        <i class="fas fa-qrcode"></i>
      </div>

      <!-- Navigation Icons -->
      <div class="rail-nav-group">
        <button class="rail-nav-btn active" id="railBtnCockpit" onclick="switchView('cockpit')" title="Cockpit Live">
          <i class="fas fa-gauge-high"></i>
          <span class="nav-tooltip">Cockpit Command</span>
        </button>
        <button class="rail-nav-btn" id="railBtnKtm" onclick="switchView('ktm')" title="KTM 3D Studio">
          <i class="fas fa-id-card"></i>
          <span class="nav-tooltip">KTM 3D Studio</span>
        </button>
        <button class="rail-nav-btn" id="railBtnProjector" onclick="switchView('projector')" title="Proyektor Kelas">
          <i class="fas fa-chalkboard-user"></i>
          <span class="nav-tooltip">Proyektor Kelas</span>
        </button>
      </div>

      <!-- Bottom Rail Action -->
      <div style="display: flex; flex-direction: column; gap: 10px; align-items: center;">
        <button class="rail-nav-btn" onclick="toggleAudioFeedback()" id="btnAudioToggle" title="Toggle Efek Suara">
          <i class="fas fa-volume-up" id="audioIcon"></i>
          <span class="nav-tooltip">Audio Feedback</span>
        </button>
        <a id="sheetLink" href="#" target="_blank" class="rail-nav-btn" title="Buka Google Sheets">
          <i class="fas fa-file-excel" style="color: #10b981;"></i>
          <span class="nav-tooltip">Google Sheets</span>
        </a>
      </div>
    </aside>

    <!-- Main Deck Stage -->
    <main class="deck-stage">
      
      <!-- Top Floating Command Island -->
      <header class="top-command-island">
        <div class="island-title">
          <h1>Smart Presensi <span class="tag-pro-pill">SPATIAL DECK 3.0</span></h1>
          <div class="island-time">
            <i class="far fa-clock" style="color:var(--primary-light);"></i>
            <span id="liveClock">--:--:-- WIB</span> &bull; 
            <span id="liveDateStr">Hari Ini</span>
          </div>
        </div>

        <div class="island-controls">
          <div class="status-capsule">
            <span class="pulse-dot" id="statusDot"></span>
            <span id="statusLabel">Memeriksa jaringan...</span>
          </div>

          <!-- 4-Theme Color Switcher -->
          <div class="theme-palette-dots" title="Ganti Tema Warna">
            <div class="theme-dot dot-exec active" onclick="setExecutiveTheme('executive')" title="Executive Titanium"></div>
            <div class="theme-dot dot-emr" onclick="setExecutiveTheme('emerald')" title="Cyber Emerald"></div>
            <div class="theme-dot dot-qtm" onclick="setExecutiveTheme('quantum')" title="Quantum Violet"></div>
            <div class="theme-dot dot-lgt" onclick="setExecutiveTheme('light')" title="Studio Light"></div>
          </div>
        </div>
      </header>

      <!-- Global Toast Alert -->
      <div class="toast-strip-spatial" id="toastStrip">
        <i class="fas fa-info-circle" id="toastIcon"></i>
        <span id="toastText">Pesan status sistem</span>
      </div>

      <!-- ==================================================================
           VIEW 1: SPATIAL COCKPIT COMMAND (HERO 3-PILLAR + DATA MATRIX)
           ================================================================== -->
      <div class="view-content-pane active" id="view-cockpit">
        
        <!-- 3-Pillar Cockpit Hero: Gauge | Scanner | Stream -->
        <div class="cockpit-hero-grid">
          
          <!-- PILLAR 1: RADIAL CIRCULAR GAUGE WIDGET -->
          <div class="spatial-card hero-pillar-gauge">
            <div class="radial-gauge-wrapper">
              <svg class="radial-gauge-svg" viewBox="0 0 160 160">
                <defs>
